# 실제 로봇 설정 (run_demo.sh 가 읽음). 이 파일을 복사해서 PC 별로 채운다:
#   cp rollout/robot.env.example ~/UNITA_PAC2026/local/robot.env      # local/ 은 깃에 안 올라감
# 값은 pour_rollout.py 의 같은 이름 인자 기본값이 된다 (명령줄 인자가 우선).

# ---- 시리얼 포트 ----
# ~/lerobot/rig_config/udev/99-serial.rules 가 보드 시리얼로 고정 이름을 만든다:
#   /dev/follower1 (5B79019054), /dev/follower2 (5B8E115667), /dev/leader1, /dev/leader2
# 설치: bash ~/lerobot/rig_config/install.sh  → 보드 재연결 → ls -l /dev/follower*
# 팀 확인(2026-10-04): follower1 = 왼팔(컵), follower2 = 오른팔(물통).
LEFT_PORT=/dev/follower1
RIGHT_PORT=/dev/follower2

# ---- 캘리브레이션 ----
# BiSOFollower 는 팔별 id 를 "{ROBOT_ID}_left" / "{ROBOT_ID}_right" 로 만들어
# ~/.cache/huggingface/lerobot/calibration/robots/so_follower/{ROBOT_ID}_left.json (right 도) 을 읽는다.
# 수집 때 쓴 id 를 알면 그대로 쓰고, 모르면 아래 CALIB_* 로 follower1/2.json 을 복사해 만든다 (없을 때만 복사).
ROBOT_ID=bimanual
CALIB_LEFT=follower1
CALIB_RIGHT=follower2

# ---- 리더암 (데이터 수집용, train/record.sh 가 읽음) ----
# [확인 필요] 리더도 1=왼팔, 2=오른팔로 가정. 수집 전에 텔레옵으로 한 번 확인할 것.
LEADER_LEFT_PORT=/dev/leader1
LEADER_RIGHT_PORT=/dev/leader2
LEADER_ID=bimanual_leader
LEADER_CALIB_LEFT=leader1
LEADER_CALIB_RIGHT=leader2

# ---- 카메라 (OpenCV, 30fps; 해상도는 학습 데이터와 같아야 함: top 640x480, 손목 320x240) ----
# /dev/videoN 번호는 USB 재연결마다 바뀌므로 고정 경로를 쓴다:
#   ls -l /dev/v4l/by-id/     (카메라 시리얼별; 같은 모델 2대가 시리얼이 같으면 겹칠 수 있음)
#   ls -l /dev/v4l/by-path/   (꽂은 USB 포트별; 같은 포트에 꽂는다면 이쪽이 확실)
# 각 카메라는 보통 video-index0 (영상) / index1 (메타데이터) 두 개가 보인다 → index0 을 쓴다.
# 아래는 자리표시자다. 실제 경로로 바꿀 것.
TOP_CAM=/dev/v4l/by-id/usb-REPLACE_TOP_CAMERA-video-index0
LEFT_CAM=/dev/v4l/by-id/usb-REPLACE_LEFT_WRIST_CAMERA-video-index0
RIGHT_CAM=/dev/v4l/by-id/usb-REPLACE_RIGHT_WRIST_CAMERA-video-index0
# 카메라 3대가 한 USB 허브를 나누면 대역폭이 모자랄 수 있다 → MJPG 지정 (빈 값 = 자동)
CAM_FOURCC=

# ---- 롤아웃 추가 인자 (선택) ----
# --max-step-deg 10 은 기본으로 켜져 있다 (끄려면 --max-step-deg 0).
# 예: ROLLOUT_ARGS="--n-action-steps 50 --max-relative-target 40"
ROLLOUT_ARGS=""
